{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@planner/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/mobile/scripts/serve-dist.js"
      ],
      "port": 8788
    }
  ]
}
