# Copy to .env for local development: cp .env.example .env
# Values below are for the docker-compose stack. When running the API on the host instead,
# replace the hostnames postgres / redis / mailpit with localhost.

NODE_ENV=development
LOG_LEVEL=debug
# Port the API listens on (inside the container in docker-compose).
API_PORT=3000
# Host ports published by docker-compose; change them if another project already uses them.
API_HOST_PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner
POSTGRES_DB=planner
POSTGRES_PORT=5432
DATABASE_URL=postgres://planner:planner@postgres:5432/planner

# --- Redis (rate limits, job queue) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Auth ---
# Dev-only value. In any shared or production environment, generate one: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60
# Accepted audiences for Google ID tokens (comma-separated iOS / Android / web client IDs)
GOOGLE_CLIENT_IDS=
# Accepted audience for Apple identity tokens (the iOS bundle ID)
APPLE_BUNDLE_ID=

# --- Email (generic SMTP; Mailpit in dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Weekly Planner <no-reply@localhost>"
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Base URL used in email links (verification, password reset, invites)
APP_LINK_BASE_URL=http://localhost:3000

# --- Business rules (DECISIONS.md) ---
ACCOUNT_DELETION_GRACE_DAYS=30
INVITE_TTL_DAYS=7

# --- Sync ---
SYNC_PUSH_MAX_MUTATIONS=500
SYNC_PULL_PAGE_SIZE=1000
TOMBSTONE_RETENTION_DAYS=90

# --- Monitoring (leave empty to disable Sentry) ---
SENTRY_DSN=
